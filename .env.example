# ---------------------------------------------------------------------------
# Public values — safe to ship in the browser bundle and safe to commit.
# Copy this file to .env.local for local development. In CI they are injected
# at build time by .github/workflows/deploy.yml from repository secrets.
#
# Supabase renamed these in 2025. In the dashboard, under
# Project Settings -> API Keys, the value below is the "publishable key"
# (it starts with sb_publishable_). Older projects show a JWT-style "anon"
# key instead; either works, the variable name is ours.
#
# It grants nothing on its own: Row Level Security is the security boundary.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Selects which store backend the app is built against: "local" (today's
# localStorage-backed demo store) or "supabase" (the real backend). Read by
# lib/backend/index.ts. "local" is the default — including when this
# variable is unset entirely — and is what the public GitHub Pages build
# ships until the Phase 3 cutover flips it.
NEXT_PUBLIC_BACKEND=local

# ---------------------------------------------------------------------------
# Tests only. Copy to .env.test.local (gitignored) and fill from lumina-dev.
#
# SUPABASE_SECRET_KEY is the "secret key" (sb_secret_...) on the same
# dashboard page — older projects call it the service_role key. It BYPASSES
# EVERY Row Level Security policy, which is exactly why the RLS test suite
# needs it to seed and clean up test users.
#
# NEVER import it in app/, components/, or lib/. It must never reach a
# browser bundle. It belongs only in .env.test.local on a developer machine.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_your_key_here
# SUPABASE_SECRET_KEY=sb_secret_your_key_here
