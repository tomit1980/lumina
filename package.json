{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "node scripts/serve-static.mjs 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts",
